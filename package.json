{
  "name": "filterstudio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "acknowledgements": "node --import tsx scripts/update-acknowledgements.ts",
    "acknowledgements:check": "node --import tsx scripts/update-acknowledgements.ts --check",
    "predev": "npm run acknowledgements",
    "prebuild": "npm run acknowledgements",
    "prebuild:client": "npm run acknowledgements",
    "dev": "vite --host 127.0.0.1",
    "dev:server": "tsx watch server/http.ts",
    "build": "npm run build:server && tsc -b && vite build",
    "build:client": "tsc -b && vite build",
    "build:server": "tsc -p tsconfig.server.json && node scripts/build-server.mjs",
    "start": "node dist-server/http.js",
    "mcp": "node dist-server/mcp-stdio.js",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@xyflow/react": "^12.9.0",
    "express": "^5.3.0",
    "katex": "^0.19.1",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "swagger-ui-dist": "^5.34.1",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/katex": "^0.16.7",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-dist": "^3.30.6",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.1.0",
    "esbuild": "^0.28.2",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  }
}
